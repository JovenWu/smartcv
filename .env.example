# Backend configuration — copy to backend/.env and fill in.
# Never commit backend/.env; it may contain credentials.

# Required for live Jev evaluations. Leave blank when SMARTCV_FAKE_EVALUATOR=true.
TYPESAFE_API_KEY=

# System One model used for screening judgments.
TYPESAFE_MODEL=jev

# Demo-only: use a deterministic fake evaluator instead of the live service.
# Never enabled implicitly; provider failures never fall back to fake scoring.
SMARTCV_FAKE_EVALUATOR=false

# Upload and worker limits.
MAX_BATCH_FILES=200
MAX_FILE_BYTES=10000000
WORKER_COUNT=4

# Evaluations with confidence at or below this value are flagged for review.
# Flagging never hides or rejects a candidate. Calibrate on the demo set.
REVIEW_CONFIDENCE_THRESHOLD=0.5

# Listing import agent. Required for "Import a listing" (link or file).
# Leave blank when SMARTCV_FAKE_IMPORTER=true.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-6-luna

# Optional: web-search fallback when a listing page is blocked or thin.
# Without it the agent relies on the fetched/dropped content alone.
TAVILY_API_KEY=

# Demo-only: deterministic fake importer, no external calls.
SMARTCV_FAKE_IMPORTER=false

# Demo gate: JSON map of username -> password. When set, every /api route
# (except /api/health and /api/auth/*) requires a session cookie created by
# the login page. Leave empty to disable auth for local dev/tests.
# Plaintext demo credentials only — not production auth.
SMARTCV_ACCOUNTS={"recruiter": "change-me"}
